{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/email-flows",
      "schedule": "0 13 * * *"
    }
  ]
}
