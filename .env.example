# Ver CLAUDE.md para a lista completa de variáveis. Este arquivo documenta
# só as adicionadas/alteradas pela correção do redirect_uri_mismatch do
# Google Calendar.

# URL canônica da aplicação, server-side only (NÃO usar prefixo VITE_ — não é
# consumida pelo cliente). Usada exclusivamente para montar o redirect_uri do
# OAuth do Google Calendar: `${APP_URL}/api/google/oauth-callback`. Precisa
# ser EXATAMENTE o domínio cadastrado em "Authorized redirect URIs" no Google
# Cloud Console — nunca é calculada a partir do origin/host/referer da
# requisição, para não quebrar quando a plataforma for acessada por um
# domínio alternativo do Vercel.
#
# Produção: APP_URL=https://plataforma.vocenohype.com.br
# Desenvolvimento: APP_URL=http://localhost:8080
APP_URL=

# Client OAuth do Google Cloud Console usado pela integração de Google
# Calendar (Configurações → Integrações). Precisa pertencer ao MESMO OAuth
# Client onde o(s) redirect URI(s) acima de APP_URL foram cadastrados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Assinatura eletrônica — Autentique (SOMENTE servidor; nunca com prefixo VITE_).
# Token: painel do Autentique → Chaves de API. Não coloque o valor em código, docs nem commits.
AUTENTIQUE_API_TOKEN=
# Segredo do endpoint de webhook (painel do Autentique → Desenvolvedor → Webhooks). Usado para
# validar a assinatura HMAC-SHA256 dos eventos recebidos.
AUTENTIQUE_WEBHOOK_PATH_SECRET=
AUTENTIQUE_WEBHOOK_SECRET_DOCUMENT=
AUTENTIQUE_WEBHOOK_SECRET_SIGNATURE=
